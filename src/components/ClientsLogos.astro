---
import SectionKicker from "./SectionKicker.astro";
import PlaceholderLogo from "./PlaceholderLogo.astro";
import { clients, proofNumber, proofLabel } from "../data/clients.ts";
---

<section id="empresas-confiam" class="clients section section--dark" aria-labelledby="clients-title">
  <div class="container">
    <SectionKicker label="Prova real" variant="dark" />
    <p class="clients__proof">
      <span class="clients__proof-number">{proofNumber}</span>
      <span class="clients__proof-label">{proofLabel}</span>
    </p>
    <h2 id="clients-title" class="clients__title">Empresas que confiam na JFIRE</h2>

    <ul class="clients__grid">
      {
        clients.map((name) => (
          <li>
            <PlaceholderLogo name={name} variant="logo" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .clients__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--jf-space-sm);
    margin-bottom: var(--jf-space-md);
  }

  .clients__proof-number {
    font-family: var(--jf-font-display);
    font-size: var(--fs-proof);
    font-weight: 800;
    color: var(--jf-fire-500);
    line-height: 1;
  }

  .clients__proof-label {
    font-family: var(--jf-font-mono);
    font-size: var(--fs-kicker);
    color: var(--jf-text-inv-mut);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .clients__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    color: var(--jf-text-inv);
    margin-bottom: var(--jf-space-xl);
    max-width: 36rem;
  }

  .clients__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--jf-space-md);
  }

  @media (min-width: 640px) {
    .clients__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .clients__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
