---
import { Icon } from "astro-icon/components";
import SectionKicker from "./SectionKicker.astro";
import CredentialBadge from "./CredentialBadge.astro";
import { credentials } from "../data/credentials.ts";

const differentials = [
  {
    icon: "lucide:award",
    title: "Experiência comprovada",
    description: "Mais de 8 anos atuando em segurança contra incêndio no Rio.",
  },
  {
    icon: "lucide:user-check",
    title: "Atendimento sob medida",
    description:
      "Soluções dimensionadas para a realidade de cada empresa ou condomínio.",
  },
  {
    icon: "lucide:graduation-cap",
    title: "Equipe técnica especializada",
    description: "Profissionais capacitados e em constante atualização.",
  },
  {
    icon: "lucide:shield-check",
    title: "Compromisso com a qualidade",
    description:
      "Material e equipamento de alta performance em cada instalação.",
  },
];
---

<section
  id="por-que"
  class="why section section--light"
  aria-labelledby="why-title"
>
  <div class="container">
    <div class="section-header">
      <SectionKicker label="Por que a JFire" />
      <h2 id="why-title" class="why__title">
        Responsabilidade técnica que você pode comprovar
      </h2>
    </div>

    <ul class="why__grid">
      {
        differentials.map((item) => (
          <li class="why__item">
            <div class="why__icon" aria-hidden="true">
              <Icon name={item.icon} width={30} height={30} />
            </div>
            <h3 class="why__item-title">{item.title}</h3>
            <p class="why__item-desc">{item.description}</p>
          </li>
        ))
      }
    </ul>

  </div>

  <div class="why__credentials">
    <div class="container why__credentials-inner">
      <p class="why__credentials-text">
        Credenciada e reconhecida pelo CREA, CAU/BR e Corpo de Bombeiros, com
        serviços executados dentro das normas técnicas e exigências oficiais.
      </p>
      <div class="why__badges">
        {credentials.map((credential) => <CredentialBadge credential={credential} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .why__title {
    font-size: var(--fs-h2);
    font-weight: 800;
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-lg);
    margin-bottom: var(--jf-space-xl);
  }

  .why__item {
    padding-block: var(--jf-space-md);
    border-top: 1px solid var(--jf-border);
  }

  .why__icon {
    color: var(--jf-red);
    margin-bottom: var(--jf-space-md);
  }

  .why__item-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: var(--jf-space-sm);
  }

  .why__item-desc {
    color: var(--jf-ink-2);
    font-size: 0.9375rem;
  }

  .why__credentials {
    background-color: var(--jf-red);
  }

  .why__credentials-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--jf-space-lg);
    padding-block: var(--jf-space-xl);
  }

  .why__credentials-text {
    color: var(--jf-on-brand);
    font-size: var(--fs-h4);
    font-weight: 600;
    max-width: 36rem;
  }

  .why__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--jf-space-md);
  }

  @media (min-width: 640px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--jf-space-xl);
    }
  }

  @media (min-width: 1024px) {
    .why__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .why__item {
      border-top: none;
      border-left: 1px solid var(--jf-border);
      padding-inline-start: var(--jf-space-lg);
      padding-block: 0;
    }

    .why__item:first-child {
      border-left: none;
      padding-inline-start: 0;
    }

    .why__credentials-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
