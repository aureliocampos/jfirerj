---
import SectionKicker from "./SectionKicker.astro";
import { whyItems } from "../data/why.ts";

const icons: Record<(typeof whyItems)[number]["icon"], string> = {
  experience: `<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  team: `<circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.75" fill="none"/><circle cx="17" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14 15c2.8 0 5 2 5 5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
  compliance: `<rect x="5" y="4" width="14" height="16" rx="1" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M8 9h8M8 13h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M8.5 17l1.5 1.5L13 15" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  support: `<path d="M4 12a8 8 0 0116 0" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="3" y="12" width="4" height="6" rx="1" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="17" y="12" width="4" height="6" rx="1" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M20 18v1a3 3 0 01-3 3h-4" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
};
---

<section class="why section section--light" aria-labelledby="why-title">
  <div class="container">
    <div class="section-header">
      <SectionKicker label="Por que a JFIRE" />
      <h2 id="why-title" class="why__title">Porque escolher a JFIRE</h2>
    </div>

    <ul class="why__grid">
      {
        whyItems.map((item) => (
          <li class="why__item">
            <div class="why__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" set:html={icons[item.icon]} />
            </div>
            <h3 class="why__item-title">{item.title}</h3>
            <p class="why__item-desc">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why__title {
    font-size: var(--fs-h2);
    font-weight: 800;
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-lg);
  }

  .why__item {
    padding-block: var(--jf-space-md);
    border-top: 1px solid var(--jf-border);
  }

  .why__icon {
    color: var(--jf-fire-500);
    margin-bottom: var(--jf-space-md);
  }

  .why__item-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: var(--jf-space-sm);
  }

  .why__item-desc {
    color: var(--jf-text-mut);
    font-size: 0.9375rem;
  }

  @media (min-width: 640px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--jf-space-xl);
    }
  }

  @media (min-width: 1024px) {
    .why__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .why__item {
      border-top: none;
      border-left: 1px solid var(--jf-border);
      padding-inline-start: var(--jf-space-lg);
      padding-block: 0;
    }

    .why__item:first-child {
      border-left: none;
      padding-inline-start: 0;
    }
  }
</style>
