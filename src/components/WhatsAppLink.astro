---
import {
  whatsappUrl,
  whatsappCaseUrl,
  type WhatsAppMessageKey,
} from "../config/site.ts";

interface Props {
  messageKey?: WhatsAppMessageKey;
  /** Quando definido, gera o CTA dinâmico "Caso: {Cliente}" em vez de messageKey. */
  caseClientName?: string;
  class?: string;
  variant?: "primary" | "outline" | "outline-light";
  ariaLabel?: string;
}

const {
  messageKey,
  caseClientName,
  class: className,
  variant = "primary",
  ariaLabel,
} = Astro.props;

const href = caseClientName
  ? whatsappCaseUrl(caseClientName)
  : whatsappUrl(messageKey!);

const variantClass =
  variant === "primary"
    ? "btn--primary"
    : variant === "outline-light"
      ? "btn--outline-light"
      : "btn--outline";
---

<a
  href={href}
  class:list={["btn", variantClass, className]}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
>
  <slot />
</a>
