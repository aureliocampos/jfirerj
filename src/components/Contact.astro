---
import { Icon } from "astro-icon/components";
import SectionKicker from "./SectionKicker.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { BUSINESS, phoneHref } from "../config/site.ts";

const fullAddress = `${BUSINESS.address.street}, ${BUSINESS.address.neighborhood}, ${BUSINESS.address.city}, ${BUSINESS.address.state}`;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(fullAddress)}&z=16&output=embed`;
---

<section
  id="contato"
  class="contact section section--light"
  aria-labelledby="contact-title"
>
  <div class="container contact__grid">
    <div class="contact__intro">
      <SectionKicker label="Contato" />
      <h2 id="contact-title" class="contact__title">
        Fale com um especialista e receba seu orçamento
      </h2>
      <p class="contact__lead">
        Tire dúvidas, peça orientação ou solicite um orçamento. Atendimento
        por WhatsApp e e-mail, de segunda a sábado, das 08h às 20h.
      </p>

      <ul class="contact__list">
        <li>
          <svg
            class="contact__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M12 3a9 9 0 00-7.8 13.4L3 21l4.7-1.2A9 9 0 1012 3z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            />
            <path
              d="M8.7 8.3c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.4.6 1.5.7 1.6.1.2.1.3 0 .5-.1.2-.2.3-.4.5-.2.2-.4.4-.2.7.2.4.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.4.2.6.1.8-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.9.9 2.2 1 .3.2.5.2.6.4.1.2.1.9-.2 1.6-.3.7-1.6 1.4-2.2 1.4-.6.1-1.1.1-3.7-1-2.6-1.1-4.2-3.8-4.4-4-.2-.2-1.3-1.7-1.3-3.3 0-1.6.9-2.4 1.2-2.7z"
              fill="currentColor"
            />
          </svg>
          <span>WhatsApp (oficial): {BUSINESS.whatsappDisplay}</span>
        </li>
        <li>
          <Icon name="lucide:phone" width={20} height={20} class="contact__icon" aria-hidden="true" />
          <a href={phoneHref(BUSINESS.phoneDisplay)}>Telefone: {BUSINESS.phoneDisplay}</a>
        </li>
        <li>
          <Icon name="lucide:mail" width={20} height={20} class="contact__icon" aria-hidden="true" />
          <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
        </li>
        <li>
          <Icon name="lucide:map-pin" width={20} height={20} class="contact__icon" aria-hidden="true" />
          <span>{fullAddress}</span>
        </li>
        <li>
          <Icon name="lucide:clock" width={20} height={20} class="contact__icon" aria-hidden="true" />
          <span>{BUSINESS.hours}</span>
        </li>
      </ul>

      <WhatsAppLink messageKey="contact" ariaLabel="Falar no WhatsApp">
        Falar no WhatsApp
      </WhatsAppLink>

      <div class="contact__map">
        <iframe
          src={mapSrc}
          title={`Mapa — ${BUSINESS.name} em ${fullAddress}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <form class="contact__form" data-contact-form novalidate>
      <div class="contact__field">
        <label for="contact-nome">Nome</label>
        <input id="contact-nome" name="nome" type="text" autocomplete="name" required />
      </div>
      <div class="contact__field">
        <label for="contact-telefone">Telefone / WhatsApp</label>
        <input id="contact-telefone" name="telefone" type="tel" autocomplete="tel" required />
      </div>
      <div class="contact__field">
        <label for="contact-tipo">Tipo</label>
        <select id="contact-tipo" name="tipo" required>
          <option value="Empresa">Empresa</option>
          <option value="Condomínio">Condomínio</option>
        </select>
      </div>
      <div class="contact__field">
        <label for="contact-mensagem">Mensagem</label>
        <textarea id="contact-mensagem" name="mensagem" rows="4" required></textarea>
      </div>
      <p class="contact__form-note" role="status" data-contact-status></p>
      <button type="submit" class="btn btn--primary contact__submit">
        Enviar
      </button>
    </form>
  </div>
</section>

<script>
  import { whatsappContactFormUrl } from "../config/site.ts";

  const form = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-contact-status]",
  );

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const nome = String(data.get("nome") ?? "").trim();
    const telefone = String(data.get("telefone") ?? "").trim();
    const tipo = String(data.get("tipo") ?? "").trim();
    const mensagem = String(data.get("mensagem") ?? "").trim();

    const url = whatsappContactFormUrl({
      nome,
      tipo,
      mensagem: `${mensagem} (telefone: ${telefone})`,
    });

    window.open(url, "_blank", "noopener,noreferrer");
    if (status) {
      status.textContent =
        "Abrindo o WhatsApp em uma nova aba para você concluir o envio.";
    }
  });
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-2xl);
  }

  .contact__title {
    font-size: var(--fs-h2);
    font-weight: 800;
  }

  .contact__lead {
    color: var(--jf-ink-2);
    margin-top: var(--jf-space-sm);
    margin-bottom: var(--jf-space-lg);
    max-width: 34rem;
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    gap: var(--jf-space-sm);
    margin-bottom: var(--jf-space-lg);
  }

  .contact__list li {
    display: flex;
    align-items: center;
    gap: var(--jf-space-sm);
    font-size: 0.9375rem;
  }

  .contact__list a:hover,
  .contact__list a:focus-visible {
    color: var(--jf-red-deep);
  }

  .contact__icon {
    flex-shrink: 0;
    color: var(--jf-red);
  }

  .contact__map {
    margin-top: var(--jf-space-lg);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-xs);
    overflow: hidden;
  }

  .contact__map iframe {
    width: 100%;
    height: 220px;
    border: 0;
    display: block;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--jf-space-md);
    padding: var(--jf-space-lg);
    background-color: var(--jf-surface);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-sm);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--jf-space-xs);
  }

  .contact__field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--jf-ink);
  }

  .contact__field input,
  .contact__field select,
  .contact__field textarea {
    padding: 0.75em 0.875em;
    font-family: var(--jf-font-body);
    font-size: var(--fs-body);
    color: var(--jf-ink);
    background-color: var(--jf-bg);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-xs);
  }

  .contact__field input:focus-visible,
  .contact__field select:focus-visible,
  .contact__field textarea:focus-visible {
    outline: 2px solid var(--jf-red-bright);
    outline-offset: 1px;
  }

  .contact__form-note {
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--jf-red-deep);
  }

  .contact__submit {
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
