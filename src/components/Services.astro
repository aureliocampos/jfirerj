---
import SectionKicker from "./SectionKicker.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { services } from "../data/services.ts";
import type { Service } from "../data/services.ts";

const icons: Record<Service["icon"], string> = {
  sprinkler: `<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  hydrant: `<rect x="8" y="6" width="8" height="14" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M6 10h4M14 10h4M10 6V4M14 6V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  alarm: `<path d="M12 3v2M5.5 5.5l1.4 1.4M18.5 5.5l-1.4 1.4M3 12h2M19 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 14a5 5 0 0110 0v3H7v-3z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 20h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  light: `<path d="M12 2v2M8 4l1 1.7M16 4l-1 1.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="8" width="6" height="8" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 20h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  sign: `<rect x="4" y="4" width="16" height="12" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M8 10h8M8 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 16v4" stroke="currentColor" stroke-width="1.5"/>`,
  smoke: `<path d="M8 16c-2 0-3-1.5-3-3s1.5-3 3-3c.5-2 2-3.5 4-3.5s3.5 1.5 4 3.5c1.5 0 3 1 3 2.5s-1.5 2.5-3 2.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/><path d="M6 18h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
};
---

<section id="servicos" class="services section section--light" aria-labelledby="services-title">
  <div class="container">
    <SectionKicker label="O que fazemos" />
    <h2 id="services-title" class="services__title">Soluções completas em prevenção e combate a incêndio</h2>
    <p class="services__lead">
      Da instalação ao laudo, cuidamos de cada etapa do seu sistema de segurança.
    </p>

    <ul class="services__grid">
      {
        services.map((service) => (
          <li class="services__card">
            <div class="services__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={icons[service.icon]} />
            </div>
            <h3 class="services__card-title">{service.title}</h3>
            <p class="services__card-desc">{service.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="services__footer">
      <p class="services__footer-text">Não sabe do que precisa?</p>
      <WhatsAppLink messageKey="services" variant="outline-dark">
        Falar com a gente e avaliar meu imóvel
      </WhatsAppLink>
    </div>
  </div>
</section>

<style>
  .services__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    margin-bottom: var(--jf-space-sm);
    max-width: 36rem;
  }

  .services__lead {
    color: var(--jf-text-mut);
    margin-bottom: var(--jf-space-xl);
    max-width: 32rem;
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-md);
    margin-bottom: var(--jf-space-xl);
  }

  .services__card {
    padding: var(--jf-space-lg);
    background-color: var(--jf-surface-raised);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-sm);
    transition: border-color 0.2s;
  }

  .services__card:hover {
    border-color: var(--jf-ember-500);
  }

  .services__icon {
    color: var(--jf-fire-500);
    margin-bottom: var(--jf-space-md);
  }

  .services__card-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: var(--jf-space-sm);
  }

  .services__card-desc {
    color: var(--jf-text-mut);
    font-size: 0.9375rem;
  }

  .services__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--jf-space-md);
    padding-top: var(--jf-space-lg);
    border-top: 1px solid var(--jf-border);
  }

  .services__footer-text {
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
