---
import { Icon } from "astro-icon/components";
import SectionKicker from "./SectionKicker.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { services } from "../data/services.ts";
---

<section
  id="servicos"
  class="services section section--light"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="section-header">
      <SectionKicker label="Serviços" />
      <h2 id="services-title" class="services__title">
        Soluções completas de combate a incêndio, do projeto à manutenção
      </h2>
      <p class="services__lead">
        Cobrimos o ciclo inteiro: projetamos, instalamos e mantemos os
        sistemas que sua edificação precisa para operar com segurança e
        passar na vistoria.
      </p>
    </div>

    <ul class="services__grid">
      {
        services.map((service) => (
          <li class="services__card">
            <div class="services__icon" aria-hidden="true">
              <Icon name={service.icon} width={32} height={32} />
            </div>
            <h3 class="services__card-title">{service.title}</h3>
            <p class="services__card-desc">{service.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="services__footer">
      <p class="services__footer-text">Não sabe do que precisa?</p>
      <WhatsAppLink messageKey="services" variant="outline">
        Falar com um especialista
      </WhatsAppLink>
    </div>
  </div>
</section>

<style>
  .services__title {
    font-size: var(--fs-h2);
    font-weight: 800;
  }

  .services__lead {
    color: var(--jf-ink-2);
    margin-top: var(--jf-space-sm);
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-lg);
    margin-bottom: var(--jf-space-2xl);
  }

  .services__card {
    padding: var(--jf-space-lg);
    background-color: var(--jf-surface);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-xs);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .services__card:hover {
    border-color: var(--jf-red);
    box-shadow: var(--jf-shadow-sm);
  }

  .services__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--jf-space-md);
    color: var(--jf-ink);
    background-color: var(--jf-bg-alt);
    border-radius: var(--jf-radius-xs);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .services__card:hover .services__icon {
    color: var(--jf-red);
    background-color: var(--jf-red-wash);
  }

  .services__card-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: var(--jf-space-sm);
  }

  .services__card-desc {
    color: var(--jf-ink-2);
    font-size: 0.9375rem;
  }

  .services__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--jf-space-md);
    padding-top: var(--jf-space-lg);
    border-top: 1px solid var(--jf-border);
  }

  .services__footer-text {
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
