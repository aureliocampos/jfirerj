---
import { Image } from "astro:assets";
import logo from "../assets/brand/jfire-logo.jpg";
import { BUSINESS, SOCIAL, phoneHref } from "../config/site.ts";

const fullAddress = `${BUSINESS.address.street}, ${BUSINESS.address.neighborhood}, ${BUSINESS.address.city}, ${BUSINESS.address.state}`;
const year = new Date().getFullYear();

const navLinks = [
  { href: "#servicos", label: "Serviços" },
  { href: "#como-funciona", label: "Como funciona" },
];
---

<footer class="footer section--anchor">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Image
        src={logo}
        alt="JFIRE"
        height={40}
        densities={[1, 2]}
        loading="lazy"
      />
      <p class="footer__summary">
        A JFire projeta, instala e regulariza sistemas de combate a incêndio
        para empresas e condomínios no Rio de Janeiro, com equipe credenciada e
        mais de 8 anos de atuação.
      </p>
      <ul class="footer__social">
        <li>
          <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="JFIRE no Facebook"
          >
            <img
              src={`${import.meta.env.BASE_URL}icon-facebook.svg`}
              alt="Facebook"
              width={40}
              height={40}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
        <li>
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="JFIRE no Instagram"
          >
            <img
              src={`${import.meta.env.BASE_URL}icon-instagram.svg`}
              alt="Instagram"
              width={40}
              height={40}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
        <li>
          <a
            href={`https://wa.me/${BUSINESS.whatsappDisplay.replace(/\D/g, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="JFIRE no WhatsApp"
          >
            <img
              src={`${import.meta.env.BASE_URL}icon-whatsapp.svg`}
              alt="WhatsApp"
              width={40}
              height={40}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      </ul>
    </div>

    <nav class="footer__block" aria-label="Navegação do rodapé">
      <h2 class="footer__heading">Navegação</h2>
      <ul class="footer__nav">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <button
            type="button"
            class="footer__nav-button"
            data-contact-drawer-open
          >
            Contato
          </button>
        </li>
      </ul>
    </nav>

    <div class="footer__block">
      <h2 class="footer__heading">Contato</h2>
      <ul class="footer__contact">
        <li>WhatsApp: {BUSINESS.whatsappDisplay}</li>
        <li>
          <a href={phoneHref(BUSINESS.phoneDisplay)}
            >Tel: {BUSINESS.phoneDisplay}</a
          >
        </li>
        <li>
          <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
        </li>
        <li>{fullAddress}</li>
        <li>{BUSINESS.hours}</li>
      </ul>
    </div>
  </div>

  <div class="container footer__legal">
    <!-- TODO(cliente): confirmar razão social e CNPJ -->
    <p>
      {BUSINESS.legalName}{BUSINESS.cnpj && ` · CNPJ ${BUSINESS.cnpj}`} &copy; {
        year
      }
      {BUSINESS.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--jf-space-2xl) var(--jf-space-xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-xl);
    margin-bottom: var(--jf-space-xl);
  }

  .footer__brand :global(img) {
    height: 2.25rem;
    width: auto;
    border-radius: var(--jf-radius-xs);
    margin-bottom: var(--jf-space-md);
  }

  .footer__summary {
    color: var(--jf-text-inv-mut);
    max-width: 24rem;
    margin-bottom: var(--jf-space-md);
  }

  .footer__social {
    display: flex;
    gap: var(--jf-space-md);
  }

  .footer__social a {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--jf-radius-pill);
    overflow: hidden;
    transition: transform 0.2s;
  }

  .footer__social a:hover,
  .footer__social a:focus-visible {
    transform: scale(1.08);
  }

  .footer__social img {
    width: 100%;
    height: 100%;
    filter: invert(1);
  }

  .footer__heading {
    font-family: var(--jf-font-mono);
    font-size: var(--fs-kicker);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--jf-text-inv);
    margin-bottom: var(--jf-space-md);
  }

  .footer__nav,
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--jf-space-sm);
    color: var(--jf-text-inv-mut);
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible,
  .footer__contact a:hover,
  .footer__contact a:focus-visible {
    color: var(--jf-text-inv);
  }

  .footer__nav-button {
    font-family: inherit;
    font-size: inherit;
    color: var(--jf-text-inv-mut);
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s;
  }

  .footer__nav-button:hover,
  .footer__nav-button:focus-visible {
    color: var(--jf-text-inv);
  }

  .footer__legal {
    padding-top: var(--jf-space-lg);
    border-top: 1px solid rgb(244 242 238 / 15%);
    color: var(--jf-text-inv-mut);
    font-size: 0.8125rem;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
