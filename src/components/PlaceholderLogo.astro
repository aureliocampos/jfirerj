---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div
  class="placeholder-logo"
  data-pending
  role="img"
  aria-label={`Foto da instalação — ${name} — aguardando arquivo do cliente`}
>
  <span class="placeholder-logo__name">{name}</span>
  <span class="placeholder-logo__tag">Foto pendente</span>
</div>

<style>
  .placeholder-logo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--jf-space-xs);
    aspect-ratio: 4 / 3;
    width: 100%;
    padding: var(--jf-space-md);
    border: 1px dashed var(--jf-border);
    border-radius: var(--jf-radius-xs);
    background-color: var(--jf-surface);
    color: var(--jf-ink-2);
    text-align: center;
  }

  .placeholder-logo__name {
    font-family: var(--jf-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .placeholder-logo__tag {
    font-family: var(--jf-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--jf-red-deep);
  }
</style>
