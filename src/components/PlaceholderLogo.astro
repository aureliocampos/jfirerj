---
interface Props {
  name: string;
  variant?: "logo" | "badge";
}

const { name, variant = "logo" } = Astro.props;
---

<div
  class:list={["placeholder-logo", `placeholder-logo--${variant}`]}
  data-pending
  aria-label={`Logo ${name} — aguardando arquivo do cliente`}
>
  <span class="placeholder-logo__name">{name}</span>
</div>

<style>
  .placeholder-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--jf-border);
    background-color: var(--jf-surface-raised);
    color: var(--jf-text-mut);
    text-align: center;
  }

  .placeholder-logo--logo {
    min-height: 4rem;
    padding: var(--jf-space-sm) var(--jf-space-md);
    border-radius: var(--jf-radius-sm);
  }

  .placeholder-logo--badge {
    min-height: 3rem;
    min-width: 5rem;
    padding: var(--jf-space-xs) var(--jf-space-sm);
    border-radius: var(--jf-radius-sm);
    font-size: 0.75rem;
  }

  .placeholder-logo__name {
    font-family: var(--jf-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
  }
</style>
