---
import CredentialBadge from "./CredentialBadge.astro";
import { credentials } from "../data/credentials.ts";
---

<section class="credential-bar section--surface" aria-label="Credenciamento">
  <div class="credential-bar__inner container">
    <p class="credential-bar__text">
      Empresa credenciada e regularizada para atuar na proteção contra incêndio.
    </p>
    <div class="credential-bar__badges">
      {
        credentials.map((credential) => (
          <CredentialBadge credential={credential} loading="eager" />
        ))
      }
    </div>
  </div>
</section>

<style>
  .credential-bar {
    padding-block: var(--jf-space-xl);
    border-bottom: 1px solid var(--jf-border);
  }

  .credential-bar__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--jf-space-md);
  }

  .credential-bar__text {
    font-size: 0.9375rem;
    color: var(--jf-text-mut);
    max-width: 28rem;
  }

  .credential-bar__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--jf-space-sm);
  }

  @media (min-width: 768px) {
    .credential-bar__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
