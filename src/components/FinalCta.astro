---
import WhatsAppLink from "./WhatsAppLink.astro";
---

<section class="final-cta section section--dark diagonal-top" aria-labelledby="final-cta-title">
  <div class="container">
    <h2 id="final-cta-title" class="final-cta__title">Pronto para proteger o seu imóvel?</h2>
    <p class="final-cta__desc">
      Fale com a JFIRE e receba uma avaliação para o seu condomínio ou empresa.
    </p>
    <div class="final-cta__actions">
      <WhatsAppLink messageKey="segment_condo" ariaLabel="Orçamento para condomínio pelo WhatsApp">
        Orçamento para condomínio
      </WhatsAppLink>
      <WhatsAppLink messageKey="segment_company" variant="outline-light" ariaLabel="Orçamento para empresa pelo WhatsApp">
        Orçamento para empresa
      </WhatsAppLink>
    </div>
  </div>
</section>

<style>
  .final-cta {
    text-align: center;
  }

  .final-cta__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    color: var(--jf-text-inv);
    margin-bottom: var(--jf-space-sm);
  }

  .final-cta__desc {
    color: var(--jf-text-inv-mut);
    max-width: 32rem;
    margin-inline: auto;
    margin-bottom: var(--jf-space-xl);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--jf-space-md);
  }
</style>
