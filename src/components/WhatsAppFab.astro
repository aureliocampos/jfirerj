---
import { whatsappUrl } from "../config/site.ts";

const href = whatsappUrl("float");
---

<a
  href={href}
  class="whatsapp-fab"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a JFIRE no WhatsApp"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M12 3a9 9 0 00-7.8 13.4L3 21l4.7-1.2A9 9 0 1012 3z"
      stroke="currentColor"
      stroke-width="1.4"
      fill="none"
      stroke-linejoin="round"
    />
    <path
      d="M8.7 8.3c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.4.6 1.5.7 1.6.1.2.1.3 0 .5-.1.2-.2.3-.4.5-.2.2-.4.4-.2.7.2.4.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.4.2.6.1.8-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.9.9 2.2 1 .3.2.5.2.6.4.1.2.1.9-.2 1.6-.3.7-1.6 1.4-2.2 1.4-.6.1-1.1.1-3.7-1-2.6-1.1-4.2-3.8-4.4-4-.2-.2-1.3-1.7-1.3-3.3 0-1.6.9-2.4 1.2-2.7z"
      fill="currentColor"
    />
  </svg>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: var(--jf-space-lg);
    bottom: var(--jf-space-lg);
    z-index: 200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--jf-radius-pill);
    background-color: var(--jf-whatsapp);
    color: var(--jf-on-brand);
    box-shadow: var(--jf-shadow-md);
    transition: background-color 0.2s, transform 0.2s;
    animation: whatsapp-fab-in 0.4s ease-out;
  }

  .whatsapp-fab:hover,
  .whatsapp-fab:focus-visible {
    background-color: var(--jf-whatsapp-hover);
    transform: scale(1.05);
  }

  @keyframes whatsapp-fab-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
  }
</style>
