---
import { Icon } from "astro-icon/components";
import { whatsappUrl } from "../config/site.ts";

const href = whatsappUrl("float");
---

<a
  href={href}
  class="whatsapp-fab"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a JFIRE no WhatsApp"
>
  <Icon name="whatsapp" width={28} height={28} />
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: var(--jf-space-lg);
    bottom: var(--jf-space-lg);
    z-index: 200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--jf-radius-pill);
    background-color: var(--jf-whatsapp);
    color: var(--jf-on-brand);
    box-shadow: var(--jf-shadow-md);
    transition:
      background-color 0.2s,
      transform 0.2s;
    animation: whatsapp-fab-in 0.4s ease-out;
  }

  .whatsapp-fab:hover,
  .whatsapp-fab:focus-visible {
    background-color: var(--jf-whatsapp-hover);
    transform: scale(1.05);
  }

  @keyframes whatsapp-fab-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
  }
</style>
