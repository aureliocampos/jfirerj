---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionKicker from "./SectionKicker.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import heroImage from "../assets/placeholders/hero.webp";
---

<!--
  TODO(cliente): substituir por foto real do Hero (bombeiro/técnico em ação
  ou sistema instalado). Placeholder atual: sala de bombas de hidrante,
  foto "Fire Pump Room, Brisbane" (Wikimedia Commons, CC BY-SA 4.0,
  autor: Bidgee) — usada só até a foto real chegar.
-->
<section id="topo" class="hero section--light" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__content">
      <SectionKicker label="Projeto · Instalação · Regularização" />
      <h1 id="hero-title" class="hero__title">
        Segurança contra incêndio para sua empresa ou condomínio operar seguro e
        em conformidade
      </h1>
      <p class="hero__desc">
        A JFire projeta, instala e regulariza sprinkler, alarme, hidrantes e
        para-raios. Equipe altamente qualificada, atendimento personalizado, com
        mais de 8 anos protegendo edificações no Rio.
      </p>
      <div class="hero__actions">
        <WhatsAppLink
          messageKey="hero"
          ariaLabel="Solicitar orçamento pelo WhatsApp"
        >
          Solicitar orçamento
        </WhatsAppLink>
        <a href="#como-funciona" class="btn btn--outline">
          Ver como funciona
          <Icon
            name="lucide:arrow-down"
            aria-hidden="true"
            width={18}
            height={18}
          />
        </a>
      </div>
    </div>

    <div class="hero__media" data-pending>
      <Image
        src={heroImage}
        alt="Instalação de sistema de combate a incêndio"
        widths={[480, 768, 1024]}
        sizes="(min-width: 900px) 45vw, 100vw"
        quality={45}
        loading="eager"
        fetchpriority="high"
        class="hero__image"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--jf-space-2xl);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--jf-space-xl);
    align-items: center;
  }

  .hero__content {
    order: 1;
  }

  .hero__title {
    font-size: var(--fs-h1);
    font-weight: 800;
    color: var(--jf-ink);
    margin-bottom: var(--jf-space-md);
  }

  .hero__desc {
    font-size: var(--fs-body);
    color: var(--jf-ink-2);
    margin-bottom: var(--jf-space-xl);
    max-width: 30rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--jf-space-md);
  }

  .hero__media {
    order: 2;
    position: relative;
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-sm);
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 120px;
    }
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .hero__media {
      order: 2;
    }

    /*
      A partir daqui a coluna de texto fica mais estreita (grid de duas
      colunas), então a curva fluida de --fs-h1 (pensada para a coluna
      cheia do mobile) já satura no teto e passa a quebrar em menos de
      três linhas. Os dois valores fixos abaixo foram calibrados nos
      breakpoints reais do grid para manter o H1 em três linhas.
    */
    .hero__title {
      font-size: 1.625rem;
    }
  }

  @media (min-width: 1200px) {
    .hero__title {
      font-size: 1.6875rem;
    }
  }
</style>
