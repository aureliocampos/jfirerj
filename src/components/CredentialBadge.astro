---
import { Image } from "astro:assets";
import type { Credential } from "../data/credentials.ts";

interface Props {
  credential: Credential;
  loading?: "eager" | "lazy";
}

const { credential, loading = "lazy" } = Astro.props;
---

<div class="credential-badge">
  <Image
    src={credential.image}
    alt={credential.name}
    height={40}
    densities={[1, 2]}
    loading={loading}
    decoding="async"
  />
</div>

<style>
  .credential-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--jf-space-xs) var(--jf-space-sm);
    background-color: var(--jf-surface);
    border: 1px solid var(--jf-border);
    border-radius: var(--jf-radius-xs);
  }

  .credential-badge :global(img) {
    height: 2rem;
    width: auto;
  }
</style>
